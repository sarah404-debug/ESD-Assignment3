    {
      "type": "timeseries",
      "title": "HTTP: response time p50 and p95, per replica (1 min window)",
      "description": "Measured at the server. p50 = typical request, p95 = the slow ones. Worked out from the histogram buckets over a 1m window: histogram_quantile(q, sum by (replica, le) (rate(..._bucket[1m]))).",
      "id": 11,
      "datasource": {
        "type": "prometheus",
