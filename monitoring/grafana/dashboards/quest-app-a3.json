{
  "uid": "quest-app-a3",
  "title": "Quest App A3: replicas behind Envoy (HTTP vs gRPC)",
  "description": "Assignment 3. Per replica (A, B, C), for HTTP GET /quests/{id} and gRPC ResolveQuest: request rate and share, active requests, p50/p95 response time (1 min window), errors by status.",
  "tags": [
    "quest-app",
    "assignment-3"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Per replica   \u00b7   left: HTTP GET /quests/{id}   \u00b7   right: gRPC QuestService.ResolveQuest   \u00b7   all rates over a 1 min window",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "HTTP: requests per second, per replica",
      "description": "rate(http_requests_total{method=\"GET\",endpoint=\"/quests/{instance_id}\"}[1m]) added up per replica. Measured by each replica (Prometheus scrapes A, B, C directly).",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (replica) (rate(http_requests_total{method=\"GET\",endpoint=\"/quests/{instance_id}\"}[1m]))",
          "legendFormat": "{{replica}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^A( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^B( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^C( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
